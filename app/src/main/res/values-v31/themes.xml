<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- На Android 12+ заставка рисуется системой: без этих атрибутов она белая,
         и тёмное приложение открывается вспышкой в глаза за вечерним столом. -->
    <style name="Theme.Mafia" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#0E0B10</item>
        <item name="android:navigationBarColor">#0E0B10</item>
        <item name="android:windowBackground">#0E0B10</item>
        <item name="android:windowSplashScreenBackground">#0E0B10</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
